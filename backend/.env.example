# --- Database ---
# MongoDB Atlas connection string (or mongodb://localhost:27017 for a local server).
# You can reuse the same Atlas cluster as Deal Rescue: just keep a different MONGODB_DB name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=returnlens

# --- Auth ---
# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# --- AI (Groq) ---
# Optional. Without a key everything runs on the built-in rules (same results, plainer summaries).
# With a key, Groq places complaints the rules couldn't and writes finding summaries (validated against the data).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=60

# --- Web ---
# Comma-separated list of frontend origins allowed to call the API (no trailing slash)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ---
MAX_UPLOAD_MB=15

# --- Daily check: re-verifies completed fixes and refreshes alerts in every workspace ---
MONITOR_ENABLED=true
MONITOR_INTERVAL_MINUTES=60
